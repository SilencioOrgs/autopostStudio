# AutoPost Studio — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Encryption ────────────────────────────────────────────────
# 32-byte key, base64-encoded (44 chars ending in =).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=your-32-byte-base64-encryption-key-here==

# ── Worker / Cron ─────────────────────────────────────────────
# 32+ random bytes, used as bearer token for /api/worker/tick.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CRON_SECRET=your-cron-secret-at-least-32-chars-long

# ── Facebook Graph API ────────────────────────────────────────
GRAPH_API_VERSION=v26.0

# ── Site URL ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
